# ChatAgent server configuration (copy to apps/server/.env for local overrides)

# HTTP
PORT=8787
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Model provider (OpenAI-compatible). Leave blank to use the built-in deterministic mock.
CHATAGENT_MODEL_BASE_URL=
CHATAGENT_MODEL_API_KEY=
CHATAGENT_MODEL_NAME=

# Agent runtime
CHATAGENT_MAX_TOOL_STEPS=8
CHATAGENT_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Authentication (Gate 1)
# development = explicit dev/test profile: x-chatagent-principal-* headers are
#               honoured and unauthenticated calls map to the configured owner.
# production  = fail closed: only a valid Bearer token authenticates.
# Default: production when NODE_ENV=production, otherwise development.
# ---------------------------------------------------------------------------
CHATAGENT_AUTH_MODE=development
# Development injection (x-chatagent-principal-* headers and the owner fallback)
# only applies to loopback callers. Set to true to allow it from other hosts
# (never do this on a shared network).
CHATAGENT_ALLOW_DEV_AUTH=false
CHATAGENT_ORGANIZATION_ID=org_local
CHATAGENT_LEGACY_OWNER_ID=dev-owner
CHATAGENT_DEV_PRINCIPAL_ID=dev-owner
CHATAGENT_DEV_PRINCIPAL_NAME=Local Owner

# ---------------------------------------------------------------------------
# Standalone product (ADR-0001)
# ChatAgent ships its own identity, conversations, messages and files.
# Third-party IM adapters are optional and OFF by default.
# ---------------------------------------------------------------------------
CHATAGENT_ENABLE_EXTERNAL_CHANNELS=false
# Native client session lifetime (seconds).
CHATAGENT_SESSION_TTL_SECONDS=43200
# How long a sender may recall their own message (seconds, 0 disables recall).
# The client reads this value from /api/agent/status instead of hardcoding it.
CHATAGENT_RECALL_WINDOW_SECONDS=120

# ---------------------------------------------------------------------------
# Webhook verification (only used when external channels are enabled)
# Each channel accepts EITHER a signing secret (HMAC-SHA256 over the raw body,
# header x-chatagent-signature: sha256=<hex>) OR a static token
# (header x-chatagent-webhook-token or ?token=).
# Production fails closed when neither is configured.
# ---------------------------------------------------------------------------
CHATAGENT_WEBHOOK_ALLOW_UNVERIFIED=false
CHATAGENT_WEBHOOK_MAX_SKEW_SECONDS=300

CHATAGENT_DINGTALK_TOKEN=
CHATAGENT_DINGTALK_SIGNING_SECRET=
CHATAGENT_FEISHU_TOKEN=
CHATAGENT_FEISHU_SIGNING_SECRET=
CHATAGENT_WECHATWORK_TOKEN=
CHATAGENT_WECHATWORK_SIGNING_SECRET=
CHATAGENT_QQ_TOKEN=
CHATAGENT_QQ_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Outbound approval (Gate 4)
# send_message / forward_file only execute when an unexpired approval matches
# the action digest (tool + target + artifact version + payload). Approvals
# expire after CHATAGENT_APPROVAL_TTL_SECONDS and are single-use.
# ---------------------------------------------------------------------------
CHATAGENT_APPROVAL_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# Test / tooling only (not read by the server)
# CHATAGENT_URL / CHATAGENT_SERVER_URL  target of scripts/smoke.mjs and the
#                                       desktop shell (default http://localhost:8787)
# SMOKE_MEMBER / SMOKE_TOKEN            credentials for a production-mode smoke run
# SMOKE_APPROVER_TOKEN                  reuse an existing approver instead of
#                                       provisioning a throwaway one (owner token!)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Message intake (agent handoff)
# ---------------------------------------------------------------------------
# deferred (default): an agent only receives a message after the recall window has
#   elapsed, and withdrawing the message cancels the handoff. immediate restores the
#   old behaviour and is only sensible when recall is disabled.
CHATAGENT_AGENT_INTAKE_MODE=deferred
# How many recent messages of a conversation an agent may read per request (1-200).
# This is the deployment default: each member can override it for themselves on the
# settings page, so raising it here still reaches everybody who never set their own.
CHATAGENT_AGENT_CONTEXT_MESSAGES=20

# ---------------------------------------------------------------------------
# Personal ids (handles): the searchable name a colleague can be found by
# ---------------------------------------------------------------------------
# How often one member may rename their handle (0 disables the cooldown).
CHATAGENT_HANDLE_CHANGE_COOLDOWN_DAYS=30
# How long a given-up handle stays reserved, so somebody else cannot claim a name
# people still associate with its previous owner.
CHATAGENT_HANDLE_RETENTION_DAYS=90
